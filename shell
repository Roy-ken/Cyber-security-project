#include <stdio.h>
#include <stdlib.h>

int main() {
    char ip[50];
    int a, b, c, d;

    printf("Enter an IP address: ");
    scanf("%49s", ip);

    if (sscanf(ip, "%d.%d.%d.%d", &a, &b, &c, &d) == 4 &&
        a >= 0 && a <= 255 &&
        b >= 0 && b <= 255 &&
        c >= 0 && c <= 255 &&
        d >= 0 && d <= 255) {

        printf("Valid IP address\n");
    } else {
        printf("Invalid IP address\n");
    }

    return 0;
}